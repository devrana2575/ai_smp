NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/ai-smp
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
AI_SERVICE_URL=http://localhost:8000
# Must exactly match SERVICE_AUTH_TOKEN in the AI service environment.
# Production requires at least 32 characters.
AI_SERVICE_TOKEN=replace-with-a-32-character-random-service-token
AI_SERVICE_TIMEOUT_MS=180000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
