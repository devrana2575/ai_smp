# AI service configuration example. Copy to .env and replace placeholders.
# The service binds to loopback by default and is intended to be reached only
# through the Express backend.

ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
# Secure defaults: debug output and interactive docs are opt-in.
DEBUG=false
ENABLE_DOCS=false

# Shared service-to-service secret. Must exactly match AI_SERVICE_TOKEN in the
# backend environment. Production requires at least 32 characters. Generate
# one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_AUTH_TOKEN=replace-with-a-32-character-random-service-token

# Comma-separated absolute origins. Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
